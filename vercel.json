{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "waitlist.spinzbikes.com" }],
      "destination": "/waitlist-index.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "waitlist.spinzbikes.com" }],
      "destination": "/waitlist-index.html"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
